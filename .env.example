# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/event_planner?retryWrites=true&w=majority

# Optional: Custom API URL (leave unset on Vercel to use the built-in /api/requirements)
# NEXT_PUBLIC_API_URL=/api/requirements
